{
    "name": "mybase",
    "module": "index.ts",
    "type": "module",
    "scripts": {
    "start": "bun run ./index.ts",
    "dev": "bun --watch run ./index.ts",
    "web": "bun run ./server/web.ts",
    "build": "bun build ./index.ts --compile --outfile app",
    "clean": "powershell -Command \"Remove-Item -Force app.exe, data.db -ErrorAction SilentlyContinue\"",
    "reset": "bun run clean && bun run start",
    "debug": "bun --inspect run ./index.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "bun run ./tests/runner.ts",
    "test-update": "bun run ./tests/runner.ts --update",
    "test:compile": "bun run ./tests/compile/compile-runner.ts",
    "test:compile:update": "bun run ./tests/compile/compile-runner.ts --update",
    "test:compile:invariants": "bun run ./tests/compile/compile-invariants.test.ts",
    "test:invariants": "bun run ./tests/invariants/member-access.invariant.ts",
    "test:abi": "bun run ./tests/abi/runtime-abi.test.ts",
    "test:all": "bun run test:invariants && bun run test:compile && bun run test:compile:invariants && bun run test:abi && bun run test",
    "perf": "bun run ./tests/perf/perf.ts",
    "perf:compare": "bun run ./tests/perf/perf.ts --compare-baseline",
    "perf:tag": "bun run ./tests/perf/perf.ts --tag",
    "perf:save": "bun run ./tests/perf/perf.ts --history-save"
    },
    "private": true,
    "devDependencies": {
        "@types/bun": "^1.3.14"
    },
    "peerDependencies": {
        "typescript": "^5"
    }
}
