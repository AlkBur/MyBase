// Polymorphic member access: Struct, Row, Columns
// B.0: dot → plain JS property, bracket → __dsl_index__
// B.1: dot → __dsl_member_get__

Структура = Новый Структура("К1", 1, "К2", 2);

a = Структура.К1;
b = Структура.К2;

c = Структура["К1"];
d = Структура["К2"];

Т = Новый ТаблицаЗначений;
Т.Колонки.Добавить("К1");
Стр = Т.Добавить();
Стр.К1 = 42;

e = Стр.К1;
f = Стр["К1"];

g = Т.Колонки.Количество();
