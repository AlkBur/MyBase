// НайтиСтроки — row dispatch path
// Проверяет method chain + Структура constructor внутри аргументов

Т = Новый ТаблицаЗначений;
Т.Колонки.Добавить("К1");
Т.Колонки.Добавить("К2");

Для i = 1 по 10 Цикл
  Стр = Т.Добавить();
  Стр.К1 = i;
  Стр.К2 = "str" + i;
КонецЦикла;

Результат = Т.НайтиСтроки(Новый Структура("К1", 5));
Результат2 = Т.НайтиСтроки(Новый Структура("К1", 5, "К2", "str5"));
