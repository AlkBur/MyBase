Процедура ТестДолжен_ПроверитьМассив() Экспорт
	
	Массив = Новый Массив();
	Массив.Добавить(10);
	Массив.Добавить(20);
	Массив.Добавить(30);
	Сообщить(Массив.Количество());

	// Вставка на 0-based индекс 1: [10, 15, 20, 30]
	Массив.Вставить(1, 15);
	Сообщить(Массив.Количество());

	// Удаление с 0-based индекса 2: [10, 15, 30]
	Массив.Удалить(2);
	Сообщить(Массив.Количество());

	// 20 был удалён — Найти возвращает Неопределено
	Позиция = Массив.Найти(20);
	Сообщить(Позиция);

	Массив.Очистить();
	Сообщить(Массив.Количество());

КонецПроцедуры

Процедура ТестДолжен_ПроверитьСтруктуру() Экспорт
	
	Структура = Новый Структура();
	Структура.Вставить("Имя", "Тест");
	Структура.Вставить("Возраст", 25);
	Сообщить(Структура.Количество());
	Сообщить(Структура.Свойство("имя"));
	Сообщить(Структура.Свойство("ВОЗРАСТ"));

	Структура.Удалить("Имя");
	Сообщить(Структура.Количество());
	

КонецПроцедуры

ТестДолжен_ПроверитьМассив();
ТестДолжен_ПроверитьСтруктуру();
