Процедура ТестЦиклов()
    // Пока
    счетчик = 0;
    Пока счетчик < 3 Цикл
        Сообщить("Пока: " + счетчик);
        счетчик = счетчик + 1;
    КонецЦикла;

    // Для
    Для i = 1 По 3 Цикл
        Сообщить("Для: " + i);
    КонецЦикла;

    // Для с шагом
    Для x = 0 По 6 Шаг 2 Цикл
        Сообщить("Шаг: " + x);
    КонецЦикла;
КонецПроцедуры

ТестЦиклов();
