ТестДолжен_ПроверитьDotДоступКСтруктуре();

Процедура ТестДолжен_ПроверитьDotДоступКСтруктуре() Экспорт
	
	Структура = Новый Структура("Ключ1", 10, "Ключ2", "Привет");
	
	// dot-read (expression-context)
	a = Структура.Ключ1;
	Сообщить(a);
	
	// bracket-read (legacy __dsl_index__)
	b = Структура["Ключ2"];
	Сообщить(b);
	
	// Доступ к несуществующему ключу
	c = Структура.НесуществующийКлюч;
	Сообщить(c);
	
	// Через вычислить (expression-engine)
	d = Вычислить("Структура.Ключ1");
	Сообщить(d);
	
КонецПроцедуры
