Процедура Приветствие()
    Имя = "Мир";
    Если Имя = "Мир" Тогда
        Сообщить("Привет, " + Имя + "!");
    Иначе
        Сообщить("Пока, " + Имя);
    КонецЕсли;
КонецПроцедуры

Процедура РаботаСБД()
    Сообщить("Запрос к базе данных...");
    Запрос = Новый Запрос;
    Запрос.Текст = "SELECT * FROM Пользователи WHERE Возраст > &Возраст";
    Запрос.УстановитьПараметр("Возраст", 25);
    Результат = Запрос.Выполнить();
    Сообщить("Найдено пользователей старше 25: " + Результат.Количество());
КонецПроцедуры

Функция Сложить(А, Б)
    Возврат А + Б;
КонецФункции

Процедура ДемоСтрок()
    Сообщить("--- Демо строковых функций ---");

    // СтрНачинаетсяС / StrStartsWith
    Сообщить(СтрНачинаетсяС("Привет мир", "Привет"));
    Сообщить(StrStartsWith("Hello world", "Hello"));

    // СтрЗаканчиваетсяНа / StrEndsWith
    Сообщить(СтрЗаканчиваетсяНа("Привет мир", "мир"));
    Сообщить(StrEndsWith("Hello world", "world"));

    // СтрРазделить / StrSplit
    Части = СтрРазделить("a,b,c", ",");
    Сообщить("Разделили на " + Части.Количество() + " части");

    // СтрСоединить / StrConcat
    Снова = СтрСоединить(Части, "-");
    Сообщить("Соединили: " + Снова);

    // СтрСравнить / StrCompare
    Сообщить(СтрСравнить("А", "А"));
    Сообщить(StrCompare("B", "A"));

    // СтрНайти / StrFind
    Поз = СтрНайти("Привет мир", "мир");
    Сообщить("Позиция 'мир': " + Поз);

    // СтрШаблон / StrTemplate
    Сообщить(СтрШаблон("Привет, %1! Вам %2 лет", "Иван", 30));

    // НСтр / NStr
    Сообщить(НСтр("ru=Привет;en=Hello", "en"));
    Сообщить(NStr("ru=Привет;en=Hello"));

    // Регистр функций не важен
    Сообщить(стрначинаетсяс("Тест", "те"));
    Сообщить(STRSTARTSWITH("Test", "Te"));
КонецПроцедуры

Приветствие();
РаботаСБД();

Сумма = Сложить(40, 2);
Сообщить("40 + 2 = " + Сумма);
Сообщить("Текущая дата: " + ТекущаяДата());

ДемоСтрок();

// Проверка регистронезависимости
приветствие();
ПРИВЕТСТВИЕ();

