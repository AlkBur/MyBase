// Структура — именованные поля
Процедура Демоструктура()
    // Создание структуры
    Персона = Новый Структура;

    // Заполнение
    Персона.Вставить("Имя", "Иван");
    Персона.Вставить("Возраст", 30);
    Персона.Вставить("Город", "Москва");

    Сообщить("Имя: " + Персона.Имя);
    Сообщить("Возраст: " + Персона.Возраст);
    Сообщить("Город: " + Персона.Город);

    // Список свойств
    Сообщить("Свойства (" + Персона.Количество() + "):");
    Для Каждого Ключ Из Персона.Свойства() Цикл
        Сообщить("  - " + Ключ);
    КонецЦикла;

    // Проверка наличия ключа
    Если Персона.Свойство("Имя") Тогда
        Сообщить("Свойство 'Имя' существует");
    КонецЕсли;

    // Структура с начальными значениями
    Точка = Новый Структура("X, Y, Z", 10, 20, 30);
    Сообщить("Точка: X=" + Точка.X + " Y=" + Точка.Y + " Z=" + Точка.Z);
КонецПроцедуры

// Соответствие — Map с любыми ключами
Процедура Демосоответствие()
    Цены = Новый Соответствие;
    Цены.Вставить("Яблоко", 45);
    Цены.Вставить("Молоко", 80);
    Цены.Вставить("Хлеб", 35);

    Сообщить("Цена яблок: " + Цены.Получить("Яблоко"));
    Сообщить("Цена молока: " + Цены.Получить("Молоко"));

    // Проверка наличия
    Если Цены.Получить("Сыр") = Неопределено Тогда
        Сообщить("Сыр не найден в ценах");
    КонецЕсли;

    // Количество
    Сообщить("Всего товаров: " + Цены.Количество());

    // Ключ — любой тип
    КлючиМассив = Новый Соответствие;
    КлючиМассив.Вставить(Новый Массив, "значение для массива");
    Сообщить("Map[Массив] = " + КлючиМассив.Получить(Новый Массив));
КонецПроцедуры

// ТаблицаЗначений
Процедура Демотаблица()
    Таблица = Новый ТаблицаЗначений;

    // Колонки
    Таблица.Колонки.Добавить("Имя");
    Таблица.Колонки.Добавить("Возраст", Новый ОписаниеТипов("Число"));
    Таблица.Колонки.Добавить("Оценка");

    // Добавление строк
    Строка1 = Таблица.Добавить();
    Строка1.Имя = "Анна";
    Строка1.Возраст = 22;
    Строка1.Оценка = 5;

    Строка2 = Таблица.Добавить();
    Строка2.Имя = "Борис";
    Строка2.Возраст = 25;
    Строка2.Оценка = 4;

    Строка3 = Таблица.Добавить();
    Строка3.Имя = "Вика";
    Строка3.Возраст = 23;
    Строка3.Оценка = 5;

    Сообщить("Студенты (" + Таблица.Количество() + "):");
    Для Каждого Стр Из Таблица Цикл
        Сообщить(СтрШаблон("  %1, %2 лет, оценка %3", Стр.Имя, Стр.Возраст, Стр.Оценка));
    КонецЦикла;

    // Поиск строк
    Результат = Таблица.НайтиСтроки(Новый Структура("Оценка", 5));
    Сообщить("Отличников: " + Результат.Количество());
    Для Каждого Стр Из Результат Цикл
        Сообщить("  - " + Стр.Имя);
    КонецЦикла;
КонецПроцедуры

// СписокЗначений
Процедура ДемосписокЗначений()
    Список = Новый СписокЗначений;

    Элемент1 = Список.Добавить(100, "Первый");
    Элемент2 = Список.Добавить(200, "Второй");
    Список.Добавить(300, "Третий");

    Сообщить("Список значений (" + Список.Количество() + "):");
    Для Каждого Элемент Из Список Цикл
        Сообщить(СтрШаблон("  Значение=%1, Представление='%2'", Элемент.Значение, Элемент.Представление));
    КонецЦикла;

    // Поиск по значению — возвращает элемент
    Найденный = Список.НайтиПоЗначению(200);
    Если Найденный <> Неопределено Тогда
        Сообщить("Найдено значение 200: " + Найденный.Представление);
    КонецЕсли;
КонецПроцедуры

// Тип и ТипЗнч
Процедура демотипы()
    Сообщить("Тип(Строка) = " + Тип("Строка"));
    Сообщить("Тип(Число) = " + Тип("Число"));

    Перем = 42;
    Сообщить("ТипЗнч(42) = " + ТипЗнч(Перем));

    Перем = "текст";
    Сообщить("ТипЗнч('текст') = " + ТипЗнч(Перем));

    Перем = Истина;
    Сообщить("ТипЗнч(Истина) = " + ТипЗнч(Перем));

    Массив = Новый Массив;
    Сообщить("ТипЗнч(Новый Массив) = " + ТипЗнч(Массив));
КонецПроцедуры

// Выполнение
Демоструктура();
Демосоответствие();
Демотаблица();
ДемосписокЗначений();
демотипы();
