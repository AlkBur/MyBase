// Цикл Для Каждого
Процедура ПоказатьМассив(Элементы)
    Сообщить("Элементы (" + Элементы.Количество() + "):");
    Для Каждого Элемент Из Элементы Цикл
        Сообщить("  - " + Элемент);
    КонецЦикла;
КонецПроцедуры

// Цикл Для
Процедура ТаблицаУмножения()
    Сообщить("Таблица умножения на 7:");
    Для i = 1 По 10 Цикл
        Сообщить(СтрШаблон("  7 x %1 = %2", i, 7 * i));
    КонецЦикла;
КонецПроцедуры

// Цикл Для с шагом
Процедура ЧётныеЧисла()
    Сообщить("Чётные числа от 0 до 10:");
    Для x = 0 По 10 Шаг 2 Цикл
        Сообщить("  " + x);
    КонецЦикла;
КонецПроцедуры

// Цикл Пока
Процедура ОбратныйОтсчёт()
    Сообщить("Обратный отсчёт:");
    i = 5;
    Пока i >= 0 Цикл
        Сообщить(i);
        i = i - 1;
    КонецЦикла;
    Сообщить("Пуск!");
КонецПроцедуры

// Демонстрация
Города = Новый Массив;
Города.Добавить("Москва");
Города.Добавить("Санкт-Петербург");
Города.Добавить("Казань");
Города.Добавить("Новосибирск");

ПоказатьМассив(Города);
ТаблицаУмножения();
ЧётныеЧисла();
ОбратныйОтсчёт();

// Вложенные циклы
Сообщить("Шахматная доска (4x4):");
Для Строка = 1 По 4 Цикл
    Линия = "";
    Для Колонка = 1 По 4 Цикл
        Если (Строка + Колонка) % 2 = 0 Тогда
            Линия = Линия + "██";
        Иначе
            Линия = Линия + "  ";
        КонецЕсли;
    КонецЦикла;
    Сообщить(Линия);
КонецЦикла;
