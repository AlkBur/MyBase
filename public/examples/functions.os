// Процедура без параметров
Процедура ПоказатьЗаголовок()
    Сообщить("=== Функции и процедуры ===");
КонецПроцедуры

// Процедура с параметрами
Процедура Приветствие(Имя, Возраст)
    Сообщить(СтрШаблон("Привет, %1! Тебе %2 лет.", Имя, Возраст));
КонецПроцедуры

// Функция с возвратом значения
Функция Факториал(N)
    Если N <= 1 Тогда
        Возврат 1;
    КонецЕсли;
    Возврат N * Факториал(N - 1);
КонецФункции

// Функция с несколькими параметрами
Функция СуммаДиапазона(Нач, Кон)
    Результат = 0;
    Для i = Нач По Кон Цикл
        Результат = Результат + i;
    КонецЦикла;
    Возврат Результат;
КонецФункции

// Процедура с выходом по Возврат
Процедура ПроверитьЧисло(N)
    Если N < 0 Тогда
        Сообщить("Число " + N + " отрицательное");
        Возврат;
    КонецЕсли;
    Если N = 0 Тогда
        Сообщить("Ноль");
        Возврат;
    КонецЕсли;
    Сообщить("Число " + N + " положительное");
КонецПроцедуры

// Процедура, вызывающая другие функции
Процедура Демонстрация()
    ПоказатьЗаголовок();
    Приветствие("Алиса", 25);
    Приветствие("Боб", 30);

    Сообщить("Факториал 5 = " + Факториал(5));
    Сообщить("Факториал 10 = " + Факториал(10));

    Сообщить("Сумма от 1 до 100 = " + СуммаДиапазона(1, 100));

    ПроверитьЧисло(42);
    ПроверитьЧисло(-7);
    ПроверитьЧисло(0);
КонецПроцедуры

// Вызов
Демонстрация();

// Функция с использованием Вычислить
Процедура ДемонстрацияВычислить()
    Сообщить("Вычислить(2 + 3 * 4) = " + Вычислить("2 + 3 * 4"));
    Сообщить("Вычислить(10 / 2 + 1) = " + Вычислить("10 / 2 + 1"));
КонецПроцедуры

ДемонстрацияВычислить();
