// Массив — основная коллекция
Процедура РаботаСМассивом()
    // Создание пустого массива
    МойМассив = Новый Массив;
    Сообщить("Новый массив, количество: " + МойМассив.Количество());

    // Добавление элементов
    МойМассив.Добавить("Яблоко");
    МойМассив.Добавить("Груша");
    МойМассив.Добавить("Слива");
    Сообщить("После добавления: " + МойМассив.Количество() + " элемента");

    // Доступ по индексу
    Сообщить("Первый элемент: " + МойМассив[0]);
    Сообщить("Последний (ВГраница): " + МойМассив[МойМассив.ВГраница()]);

    // Поиск
    Индекс = МойМассив.Найти("Груша");
    Если Индекс <> Неопределено Тогда
        Сообщить("Груша найдена на позиции: " + Индекс);
    КонецЕсли;

    // Вставка по индексу
    МойМассив.Вставить(1, "Апельсин");
    Сообщить("После вставки Апельсин на позицию 1:");

    Для Каждого Элемент Из МойМассив Цикл
        Сообщить("  - " + Элемент);
    КонецЦикла;

    // Удаление
    МойМассив.Удалить(2);
    Сообщить("После удаления индекса 2, осталось: " + МойМассив.Количество());

    // Очистка
    МойМассив.Очистить();
    Сообщить("После очистки: " + МойМассив.Количество());
КонецПроцедуры

// Массив с размером
Процедура МассивСРазмером()
    Сообщить("Массив на 5 элементов (заполнены Неопределено):");
    Большой = Новый Массив(5);
    Сообщить("Количество: " + Большой.Количество());
    Большой[0] = "Первый";
    Большой[4] = "Последний";
    Сообщить("Элемент [0]: " + Большой[0]);
    Сообщить("Элемент [4]: " + Большой[4]);
КонецПроцедуры

// ФиксированныйМассив (immutable)
Процедура ФиксированныйМассив()
    Исходный = Новый Массив;
    Исходный.Добавить("Один");
    Исходный.Добавить("Два");
    Исходный.Добавить("Три");

    Фикс = Новый ФиксированныйМассив(Исходный);
    Сообщить("Фиксированный массив, количество: " + Фикс.Количество());
    Сообщить("Элемент [1]: " + Фикс[1]);

    // Попытка изменения — будет ошибка
    Попытка
        Фикс[0] = "Новое значение";
    Исключение
        Сообщить("Ошибка (ожидаемо): " + ИнформацияОбОшибке().Описание);
    КонецПопытки;

    // Копия в mutable
    Копия = Новый Массив(Фикс);
    Копия[0] = "Изменено";
    Сообщить("Копия [0]: " + Копия[0]);
КонецПроцедуры

РаботаСМассивом();
МассивСРазмером();
ФиксированныйМассив();
