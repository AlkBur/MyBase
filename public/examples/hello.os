Процедура Приветствие(Имя)
    Сообщить("Привет, " + Имя + "!");
КонецПроцедуры

// Простой вывод
Сообщить("=== Добро пожаловать в DSL Playground ===");

// Вызов процедуры
Приветствие("Мир");

// Числа и строки
Сумма = 42 + 7;
Сообщить("42 + 7 = " + Сумма);

// Булевы значения
Сообщить("Истина = " + Истина);
Сообщить("Ложь = " + Ложь);

// Null и Неопределено
Сообщить("Null = " + Null);
Сообщить("Неопределено = " + Неопределено);

// Форматирование
Сообщить(СтрШаблон("Шаблон: %1 встретился с %2 раз", "Кот", "Собака"));

// Строковые функции
Текст = "Привет, DSL!";
Если СтрНачинаетсяС(Текст, "При") Тогда
    Сообщить("Текст начинается с 'При'");
КонецЕсли;

Сообщить("СтрНайти(Текст, 'DSL') = " + СтрНайти(Текст, "DSL"));
